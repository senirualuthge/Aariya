# Pulse AI News — Environment Variables Template
# Copy this file to .env and fill in your keys.

# Required
OPENROUTER_API_KEY=sk-or-v1-your-key-here
NEWSAPI_KEY=your-newsapi-key

# Optional (add services as needed)
SERPAPI_KEY=
CURRENT_NEWS_API=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Database (default works with docker-compose.yml)
PULSE_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/pulse_news

# AI Girl bridge
AIGIRL_API_URL=http://localhost:8000

# Pulse News backend port
PULSE_PORT=8001

# LLM
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PULSE_CHAT_MODEL=poolside/laguna-xs.2:free

# Geo-filtering (comma-separated)
PULSE_ALLOWED_REGIONS=

# Kafka (optional)
PULSE_KAFKA_BROKER=localhost:9092

# Qdrant (optional)
PULSE_QDRANT_HOST=localhost
PULSE_QDRANT_PORT=6333

# Firebase (optional)
FIREBASE_CREDENTIALS=firebase-credentials.json

# Topic categories for trend tracking
PULSE_TREND_CATEGORIES=tech,economy,global,security,other

# Reddit
PULSE_SUBREDDITS=worldnews,technology,news,economy

# NewsAPI categories to fetch
PULSE_NEWSAPI_CATEGORIES=general,technology,business

# Trusted domains for source credibility (format: domain:score,domain:score)
PULSE_TRUSTED_DOMAINS=reuters.com:0.95,apnews.com:0.95,bbc.com:0.92,nytimes.com:0.90

# Default credibility score for unknown sources
PULSE_DEFAULT_CREDIBILITY=0.60

# ── Face / Person Identification System ───────────────────────────────────

# Camera device index
PULSE_CAMERA_DEVICE=0
PULSE_CAMERA_NAME=cam_1
PULSE_FACE_FRAME_SKIP=2

# InsightFace model (buffalo_l, buffalo_s, buffalo_m)
PULSE_FACE_MODEL=buffalo_l
PULSE_FACE_CTX_ID=0

# DeepSORT tracking params
PULSE_FACE_TRACK_MAX_AGE=30
PULSE_FACE_TRACK_N_INIT=3
PULSE_FACE_TRACK_NN_BUDGET=100

# RL model path
PULSE_FACE_RL_MODEL_PATH=rl_model.pt

# Replay buffer dir
PULSE_REPLAY_DIR=replay_buffer

# Calibration path
PULSE_FACE_CALIBRATION_PATH=calibration.json
