{
  "name": "ai-girl-frontend",
  "version": "4.0.0",
  "private": true,
  "main": "main.js",
  "type": "module",
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "^12.6.2",
    "cesium": "^1.144.0",
    "egm96-universal": "^1.1.1",
    "face-api.js": "^0.22.2",
    "framer-motion": "^10.12.16",
    "lucide-react": "^0.244.0",
    "mgrs": "^2.2.0",
    "openai": "^6.16.0",
    "pbf": "^5.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.6.2",
    "satellite.js": "^7.1.0",
    "three": "^0.182.0",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "three-stdlib": "2.36.0",
    "node-fetch": "2.7.0",
    "form-data": "4.0.6",
    "fflate": ">=0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^40.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "vite": "^7.2.4",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "backend": "bash scripts/backend.sh",
    "backend:start": "bash scripts/backend.sh start",
    "backend:stop": "bash scripts/backend.sh stop",
    "backend:restart": "bash scripts/backend.sh restart",
    "backend:status": "bash scripts/backend.sh status",
    "health": "bash scripts/backend.sh health",
    "dev:brain": "node scripts/dev-brain.mjs",
    "dev:ui": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5173 --strictPort",
    "dev": "node scripts/dev.mjs",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "gui": "node node_modules/electron/cli.js .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit --json 2>&1 || true",
    "security:audit:fix": "npm audit fix",
    "test": "npm run test:unit && npm run test:gev",
    "test:unit": "node --test build-summary.test.js vault-context.test.js vault-search.test.js background-polls.test.js scripts/audit_gate.test.mjs",
    "test:gev": "node scripts/gev/run-unit-tests.mjs",
    "test:backend": "bash run_backend_tests.sh",
    "test:backend:win": "run_backend_tests.bat",
    "test:all": "npm test && npm run test:backend",
    "stress": "node scripts/stress-test.mjs"
  }
}
