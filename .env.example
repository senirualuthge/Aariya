# =============================================================================
# AARIYA AI Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================
# Legend:
#   🔴 REQUIRED  = Must be set for the application to function
#   🟡 RECOMMENDED = Strongly recommended; some features require it
#   ⚪ OPTIONAL  = Defaults are sensible; only override if needed
# =============================================================================

# ── LLM / AI Providers ──────────────────────────────────────────────────────
OPENAI_API_KEY=                     # 🔴 REQUIRED: OpenAI API key (required for GPT models)
OPENAI_BASE_URL=                    # ⚪ OpenAI-compatible base URL (optional)
ANTHROPIC_API_KEY=                  # 🟡 Anthropic API key (alternative provider)
GEMINI_API_KEY=                     # 🟡 Google Gemini API key (alternative provider)
LLM_PROVIDER=openai                 # ⚪ openai | anthropic | gemini | local
LLM_MODEL=gpt-4o                    # ⚪ Model name (gpt-4o, claude-3-5-sonnet, etc.)
LLM_API_KEY=                        # ⚪ Override API key for LLM provider
LLM_API_URL=                        # ⚪ Override API URL for LLM provider
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # ⚪ Embedding model for semantic memory

# ── Server ──────────────────────────────────────────────────────────────────
SERVERPORT=8000                     # ⚪ HTTP/WS server port
PORT=8000                           # ⚪ Server port (fallback, overrides SERVERPORT)
MAX_PAYLOAD_BYTES=1048576           # ⚪ Max request payload (bytes)
MAX_CALLS_PER_USER_PER_DAY=500      # ⚪ Rate limit per user per day
MAX_CONCURRENT_SESSIONS=5           # ⚪ Max concurrent WebSocket sessions
DEV_TOKEN_ENABLED=0                 # ⚪ Enable /dev-token endpoint (1 = on)
LOG_LEVEL=INFO                      # ⚪ DEBUG | INFO | WARNING | ERROR
STRUCTLOG_FORMAT=json               # ⚪ json | console
REQUIRE_WS_AUTH=1                   # ⚪ Require auth for WebSocket connections (all /ws/* handlers call verify_ws_token)
WS_SECRET_TOKEN=                    # 🔴 REQUIRED when REQUIRE_WS_AUTH=1 — shared secret clients present as ?token= or Authorization: Bearer. Without it every signed control frame is rejected (fail-closed).
CORS_ORIGINS=                      # ⚪ Comma-separated credentialed-origin allowlist; empty = local dev defaults (localhost:3000/5173/4173/8000/8001 + app://./capacitor://localhost/file://"null"). Set this for LAN/tailscale mobile clients or a hosted front end.
DEV_WS_USER_ID=                     # ⚪ Dev override WS user ID

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aariya  # 🔴 REQUIRED: PostgreSQL connection string
REDIS_URL=redis://localhost:6379/0  # 🟡 Redis connection string (some features use it)
REDIS_KEY_PREFIX=aariya:            # ⚪ Redis key namespace prefix
REDIS_STREAMS_URL=                  # ⚪ Redis Streams URL (separate instance)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092  # ⚪ Kafka bootstrap servers
NEO4J_URI=bolt://localhost:7687     # ⚪ Neo4j graph database URI
NEO4J_USER=neo4j                    # ⚪ Neo4j username
NEO4J_PASSWORD=                     # ⚪ Neo4j password
DEFAULT_ADMIN_PASSWORD=             # ⚪ Default admin password for seed
STORE_DB_PATH=data/stores.db        # ⚪ Persistent store DB path
CHROMA_DB_PATH=./memory_db          # ⚪ Chroma vector DB path
CHROMA_PERSIST_DIR=./data/chroma    # ⚪ Chroma persistence directory
INTEGRITY_DB_PATH=data/integrity.db # ⚪ Integrity check DB path

# ── Obsidian Dual-Vault RAG ──────────────────────────────────────────────────
# Indexed by server/systems/rag/obsidian_indexer.py at server startup.
#   obsidian_developer -> read-only architecture context for the AI
#   obsidian_runtime   -> AI-written episodic logs
OBSIDIAN_DEVELOPER_VAULT_PATH=      # ⚪ Path to the developer Obsidian vault
OBSIDIAN_RUNTIME_VAULT_PATH=        # ⚪ Path to the runtime Obsidian vault
OBSIDIAN_PERSIST_DIR=./data/chroma/obsidian  # ⚪ Chroma persist path for vault chunks
OBSIDIAN_CHUNK_TARGET_CHARS=1500    # ⚪ Target chunk size (chars)
OBSIDIAN_MAX_CHUNK_CHARS=2500       # ⚪ Hard cap per chunk (chars)
RUNTIME_TELEMETRY_INTERVAL_MIN=30   # ⚪ How often live metrics (uptime, memory, CPU, active agents)
                                    #    are logged to the runtime vault's Logs/ dir
RUNTIME_LOG_RETENTION_DAYS=30       # ⚪ Daily-rotation retention: dated logs in the runtime vault's
                                    #    Logs/ dir (and Logs/Archive/) older than this are deleted and
                                    #    their chunks purged from Chroma. Today's file + _TEMPLATE are
                                    #    never touched. Set 0 to delete everything except today.
RUNTIME_LOG_MAX_KB=512              # ⚪ Rotation cap: when today's runtime log exceeds this size it is
                                    #    moved to Logs/Archive/ (kept on disk, excluded from indexing)
                                    #    so a single busy day can't grow unboundedly.

# ── Authentication / JWT ────────────────────────────────────────────────────
JWT_SECRET=                         # 🔴 REQUIRED: JWT signing secret — generate with:
                                     #   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_EXPIRE_MINUTES=60               # ⚪ JWT token expiry

# ── Memory & Storage Paths ──────────────────────────────────────────────────
MEMORY_LEGACY_PATH=data/memory_legacy.json
LEARNING_STORAGE_PATH=data/learning.json
USER_PROFILE_PATH=data/user_profiles.json
IDENTITY_STORAGE_PATH=data/identity/
KNOWLEDGE_GRAPH_PATH=data/knowledge_graph/
MODEL_STORAGE_DIR=data/models/
REPLAY_BUFFER_DIR=data/replay/
COMPLIANCE_STORAGE_PATH=data/compliance/
EVAL_LOG_PATH=data/eval/
FEEDBACK_LOG_PATH=data/feedback/
CALIBRATION_PATH=data/calibration/

# ── Voice / Speech ──────────────────────────────────────────────────────────
STT_ENGINE=faster-whisper           # ⚪ faster-whisper | whisper-cpp | local
WHISPER_MODEL=base                  # ⚪ faster-whisper model size
WHISPER_CPP_URL=                    # ⚪ whisper-cpp server URL
TTS_PROVIDER=piper                  # ⚪ piper | openai | coqui | elevenlabs
PIPER_EXECUTABLE=                   # ⚪ Path to piper binary
PIPER_MODEL=                        # ⚪ Path to piper voice model
OPENAI_TTS_MODEL=tts-1              # ⚪ OpenAI TTS model
ELEVENLABS_API_KEY=                 # 🟡 ElevenLabs API key
USE_COQUI=false                     # ⚪ Use Coqui TTS
USE_PIPER=true                      # ⚪ Use Piper TTS
XTTS_SPEAKER_WAV=                   # ⚪ XTTS speaker reference WAV
XTTS_LANGUAGE=en                    # ⚪ XTTS language
XTTS_USE_GPU=true                   # ⚪ XTTS GPU acceleration
STREAM_SAMPLE_RATE=24000            # ⚪ Audio stream sample rate
STREAM_CHUNK_SIZE=1024              # ⚪ Audio stream chunk size
AUDIO_RETENTION_DAYS=7              # ⚪ Audio recording retention
TRANSCRIPT_RETENTION_DAYS=30        # ⚪ Transcript retention
TURN_URLS=turn:127.0.0.1:3478,stun:stun.l.google.com:19302  # ⚪ WebRTC TURN servers
TURN_USERNAME=                      # ⚪ TURN server username
TURN_CREDENTIAL=                    # ⚪ TURN server credential
TURN_PAUSE_THRESHOLD_MS=500         # ⚪ Turn-taking pause threshold
MIN_TURN_DURATION_MS=200            # ⚪ Minimum turn duration

# ── Autonomy (Proactive Behavior) ───────────────────────────────────────────
ENABLE_AUTONOMY=true                # ⚪ Enable autonomous agent behavior
AUTONOMY_INTERVAL_MIN=10            # ⚪ Min interval between autonomous actions (min)
AUTONOMY_INTERVAL_MAX=60            # ⚪ Max interval between autonomous actions (min)
AUTONOMY_MAX_PER_HOUR=24            # ⚪ Max autonomous actions per hour
AUTONOMY_COOLDOWN=15                # ⚪ Cooldown between autonomous actions (sec)
AUTONOMY_CONFIDENCE=0.3             # ⚪ Confidence threshold for autonomous action
SILENCE_WINDOW_START=2              # ⚪ No-autonomy window start (hour, 0-23)
SILENCE_WINDOW_END=6                # ⚪ No-autonomy window end (hour, 0-23)

# ── External APIs ───────────────────────────────────────────────────────────
NEWSAPI_KEY=                        # 🟡 NewsAPI.org key — get free at https://newsapi.org/register
SERPAPI_KEY=                        # 🟡 SerpAPI key (Google search)
BING_API_KEY=                       # 🟡 Bing Search API key
HIBP_API_KEY=                       # 🟡 Have I Been Pwned API key
NVD_API_KEY=                        # 🟡 National Vulnerability Database API key
NPM_CVE_OVERRIDES=                  # ⚪ NPM CVE severity overrides (JSON)
SD_API_URL=                         # ⚪ Stable Diffusion API URL
FIREBASE_CREDENTIALS=               # ⚪ Firebase credentials JSON path
MOBILE_DASHBOARD_API=               # ⚪ Mobile dashboard external API URL
MOBILE_DASHBOARD_API_KEY=           # ⚪ Mobile dashboard API key

# ── Calendar ────────────────────────────────────────────────────────────────
CALENDAR_ICS_PATH=                  # ⚪ Path to .ics calendar file

# ── Prediction / Trading ────────────────────────────────────────────────────
PREDICTION_SYMBOLS=                 # ⚪ Comma-separated symbols (e.g. AAPL,BTC-USD)
PREDICTION_INTERVAL=60              # ⚪ Prediction polling interval (minutes)
PREDICTION_HORIZONS=                # ⚪ Comma-separated horizons (e.g. 15,60,240)
BANDIT_STRATEGY=epsilon             # ⚪ Multi-armed bandit strategy
BANDIT_PARAMS_PATH=                 # ⚪ Custom bandit params path

# ── RL / Sandbox ────────────────────────────────────────────────────────────
RL_SANDBOX_TIMEOUT=15               # ⚪ RL sandbox timeout (seconds)
RL_SANDBOX_MAX_MEMORY=128           # ⚪ RL sandbox memory limit (MB)
RL_SANDBOX_MAX_AGENTS=20            # ⚪ RL sandbox max agents
DQN_MODEL_PATH=                     # ⚪ DQN model path
REPLAY_BUFFER_SIZE=10000            # ⚪ Replay buffer capacity

# ── Agent Settings ──────────────────────────────────────────────────────────
AGENT_CACHE_TTL=300                 # ⚪ Agent cache TTL (seconds)
AGENT_LOG_LEVEL=INFO                # ⚪ Agent-specific log level
AGENT_RATE_LIMIT=100                # ⚪ Agent requests per minute
MAX_CONCURRENT_AGENTS=10            # ⚪ Max concurrent agent executions
MAX_SEARCH_RESULTS=5                # ⚪ Max search results per query
MAX_REASONING_STEPS=10              # ⚪ Max reasoning chain depth

# ── Self-Healing / Anomaly Detection ────────────────────────────────────────
ANOMALY_LATENCY_MS=1500             # ⚪ Latency anomaly threshold (ms)
ANOMALY_CONFIDENCE=0.3              # ⚪ Confidence drop anomaly threshold
ANOMALY_ERROR_RATE=0.1              # ⚪ Error rate anomaly threshold
ANOMALY_HALLUCINATION=0.4           # ⚪ Hallucination score anomaly threshold

# ── Security ────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60                   # ⚪ Max requests per window
RATE_LIMIT_WINDOW=60                # ⚪ Rate limit window (seconds)
BLOCK_DURATION=3600                 # ⚪ Auto-block duration (seconds)
CVE_PATCH_WHITELIST=                # ⚪ Comma-separated CVE IDs to auto-patch
MESH_PEER_ID=                       # ⚪ Mesh security peer ID

# ── Recorrection ────────────────────────────────────────────────────────────
MAX_RECORRECTIONS=3                 # ⚪ Max recorrection attempts
RECORRECTION_COOLDOWN=60            # ⚪ Recorrection cooldown (seconds)

# ── RSDK ────────────────────────────────────────────────────────────────────
RSDK_BUCKET_START=1740000000        # ⚪ RSDK bucket epoch

# ── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0                # ⚪ Gateway server host
GATEWAY_PORT=8000                   # ⚪ Gateway server port

# ── Vision / Tracking ───────────────────────────────────────────────────────
RECOGNITION_CONFIDENCE_THRESHOLD=0.6
TRACKER_IOU_THRESHOLD=0.3
TRACKER_MAX_AGE=30
TRACKER_MAX_DISAPPEARED=5
TRACKER_NN_BUDGET=100
TRACKER_N_INIT=3

# ── Frontend Vite Overrides ─────────────────────────────────────────────────
VITE_OPENAI_API_KEY=                # ⚪ Frontend OpenAI key override
VITE_OPENAI_BASE_URL=               # ⚪ Frontend OpenAI base URL override
VITE_LLM_MODEL=gpt-4o               # ⚪ Frontend model override
VITE_AGENT_WS_URL=                  # ⚪ Agent WebSocket URL (defaults to ws://<host>:8000/api/agents/ws)
BUILD_WARN_MAX_AGE_HOURS=24         # ⚪ Build-warning freshness window (hours) — controls when the
                                    #    build-warnings banner shows and the dashboard Build tab's
                                    #    OUTDATED badge appears. Exposed to the renderer via vite's
                                    #    envPrefix (so the non-VITE_ name works in dev + build); the
                                    #    VITE_BUILD_WARN_MAX_AGE_HOURS name also works.

# ── Compliance ──────────────────────────────────────────────────────────────
CONSENT_RETENTION_DAYS=365          # ⚪ User consent record retention

# ── Local LLM ───────────────────────────────────────────────────────────────
USE_LOCAL_LLM=false                 # ⚪ Force local (offline) LLM mode

# ── Pulse News ───────────────────────────────────────────────────────────────
AIGIRL_API_URL=http://localhost:8000  # ⚪ AI Girl server URL for news alerts
PULSE_DATABASE_URL=                   # ⚪ Pulse news database URL
PULSE_KAFKA_BROKER=localhost:9092    # ⚪ Pulse news Kafka broker
PULSE_QDRANT_HOST=localhost           # ⚪ Pulse news Qdrant host
PULSE_QDRANT_PORT=6333                # ⚪ Pulse news Qdrant port
