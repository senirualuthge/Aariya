def update_belief(db, belief):\
    db.execute("""\
      INSERT INTO beliefs (user_id,subject,predicate,object,confidence)\
      VALUES (%s,%s,%s,%s,%s)\
      ON CONFLICT (user_id,subject,predicate,object)\
      DO UPDATE SET\
        confidence = LEAST(1.0, beliefs.confidence + 0.1),\
        evidence_count = beliefs.evidence_count + 1,\
        last_updated = now()\
    """, (...))\
