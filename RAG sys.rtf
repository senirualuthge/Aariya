# server/systems/debate/council.py\
def silent_debate(context):\
    votes = []\
\
    for agent in COUNCIL:\
        vote = llm.judge(\
            prompt=f"From \{agent\} perspective, is this response acceptable?",\
            context=context\
        )\
        votes.append(vote)\
\
    return aggregate(votes)\
\
