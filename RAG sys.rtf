def compress_old_memories(db, user_id):\
    db.execute("""\
      SELECT content FROM memories\
      WHERE user_id=%s AND type='turn'\
      ORDER BY created_at ASC\
      LIMIT 20\
    """, (user_id,))\
\
    text = "\\n".join(r[0] for r in db.fetchall())\
    summary = llm.summarize(text)\
\
    db.execute("""\
      INSERT INTO memories (user_id,type,content,importance)\
      VALUES (%s,'summary',%s,0.7)\
    """, (user_id, summary))\
\
    db.execute("""\
      DELETE FROM memories\
      WHERE id IN (\
        SELECT id FROM memories\
        WHERE user_id=%s AND type='turn'\
        ORDER BY created_at ASC\
        LIMIT 20\
      )\
    """, (user_id,))\
\
